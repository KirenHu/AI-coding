{
  "manifest_version": 3,
  "name": "WorkTwin · 网站操作采集",
  "version": "0.4.0",
  "description": "按网站白名单持续采集脱敏操作，并保留可信流程任务的独立范围",
  "permissions": [
    "tabs",
    "scripting",
    "webNavigation",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://flow.example.com/*"
    ]
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "120"
}
