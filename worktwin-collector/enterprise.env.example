# Administrator only: replace placeholders before starting.
WORKTWIN_BYOK_BASE_URL=https://your-model-provider.example/v1
WORKTWIN_BYOK_MODEL=your-enterprise-model
WORKTWIN_BYOK_API_KEY=replace-with-enterprise-provider-key
# Assign a distinct random token to every employee; use JSON, no model keys here.
WORKTWIN_PUBLISHER_TOKENS={"employee-a":"replace-with-at-least-32-random-bytes"}
WORKTWIN_DAILY_CALL_LIMIT=1000
WORKTWIN_DAILY_TOKEN_LIMIT=2000000
WORKTWIN_MINUTE_CALL_LIMIT=20
WORKTWIN_MODEL_CONCURRENCY=4
