# First setup: use a separate random administrator token (at least 32 characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
WORKTWIN_ADMIN_TOKEN=replace-with-a-separate-long-random-admin-token
# Start without a model, then configure through Settings > Enterprise > Administrator.
WORKTWIN_PUBLISHER_TOKENS={}
WORKTWIN_BYOK_BASE_URL=https://api.openai.com/v1
WORKTWIN_BYOK_MODEL=
WORKTWIN_BYOK_API_KEY=
WORKTWIN_DAILY_CALL_LIMIT=1000
WORKTWIN_DAILY_TOKEN_LIMIT=2000000
WORKTWIN_MINUTE_CALL_LIMIT=20
WORKTWIN_MODEL_CONCURRENCY=4
